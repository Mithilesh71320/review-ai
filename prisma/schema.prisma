generator client {
  // Default @prisma/client location (node_modules) — reliable on Vercel.
  // Custom src/generated output often fails to load the Linux query engine at runtime.
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ReviewSource {
  GOOGLE
  YELP
  FACEBOOK
  TRIPADVISOR
}

enum AlertType {
  NEGATIVE_REVIEW
  RATING_DROP
  TREND
  POSITIVE_SPIKE
}

enum AlertSeverity {
  HIGH
  MEDIUM
  LOW
}

model Business {
  id                String            @id @default(uuid())
  userId            String            @unique
  name              String
  email             String?
  phone             String?
  website           String?
  placeId           String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  reviews           Review[]
  alerts            Alert[]
  settings          BusinessSettings?
  sources           SourceConnection[]
  rules             AlertRule[]
  managedBusinesses ManagedBusiness[]
}

model ManagedBusiness {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  placeId    String   @unique
  accountName String?
  locationName String?
  mapsUri    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reviews    Review[]
  alerts     Alert[]

  @@index([businessId, createdAt(sort: Desc)])
}

model Review {
  id          String       @id @default(uuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  managedBusinessId String?
  managedBusiness ManagedBusiness? @relation(fields: [managedBusinessId], references: [id], onDelete: SetNull)
  author      String
  text        String
  rating      Int
  sentiment   Sentiment
  sentimentConfidence Float?
  sentimentReason     String?
  reviewTags          Json?
  source      ReviewSource
  externalRef String?
  reviewResourceName String?
  reviewReply String?
  reviewRepliedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([businessId, createdAt(sort: Desc)])
  @@index([managedBusinessId, createdAt(sort: Desc)])
  @@index([businessId, managedBusinessId, createdAt(sort: Desc)])
  @@index([businessId, managedBusinessId, sentiment])
  @@unique([businessId, source, externalRef])
}

model Alert {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  managedBusinessId String?
  managedBusiness ManagedBusiness? @relation(fields: [managedBusinessId], references: [id], onDelete: SetNull)
  type        AlertType
  title       String
  description String
  severity    AlertSeverity
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, managedBusinessId, createdAt(sort: Desc)])
  @@index([businessId, isRead, createdAt(sort: Desc)])
  @@index([businessId, managedBusinessId, isRead])
}

model SourceConnection {
  id         String       @id @default(uuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source     ReviewSource
  connected  Boolean      @default(false)
  accessToken String?
  refreshToken String?
  accessTokenExpiresAt DateTime?
  tokenType String?
  scope String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([businessId, source])
  @@index([businessId])
}

model AlertRule {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        AlertType
  name        String
  description String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, type])
  @@index([businessId])
}

model BusinessSettings {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  weeklyDigest       Boolean  @default(true)
  autoRespond        Boolean  @default(true)
  aiProvider         String   @default("gemini")
  sentimentModel     String   @default("balanced")
  analysisLanguage   String   @default("en")
  businessContext    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
